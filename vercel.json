{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "installCommand": "npm ci",
    "buildCommand": "npm run build && rm -f bootstrap/cache/config.php bootstrap/cache/routes-v7.php bootstrap/cache/routes.php && rm -rf node_modules storage/debugbar database/backup sql && rm -f baakh_backup.sql",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "excludeFiles": "{node_modules/**,**/tests/**,**/Tests/**,storage/debugbar/**,database/backup/**,storage/app/sindhi_wordnet/**,sql/**,baakh_backup.sql,.phpunit.result.cache,public/vendor/datatables-plugins/**,public/vendor/summernote/**,public/vendor/fontawesome-free/**}"
        }
    },
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.baakh.com" }],
            "destination": "https://baakh.com/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "beta.baakh.com" }],
            "destination": "https://baakh.com/:path*",
            "permanent": true
        },
        {
            "source": "/poets/llms.txt",
            "destination": "/sd/poets/llms.txt",
            "permanent": true
        },
        {
            "source": "/poetry/llms.txt",
            "destination": "/sd/poetry/llms.txt",
            "permanent": true
        },
        {
            "source": "/poetry",
            "destination": "/sd/poetry",
            "permanent": true
        },
        {
            "source": "/couplets",
            "destination": "/sd/couplets",
            "permanent": true
        },
        {
            "source": "/poets",
            "destination": "/sd/poets",
            "permanent": true
        },
        {
            "source": "/poets/:slug",
            "destination": "/sd/poet/:slug",
            "permanent": true
        },
        {
            "source": "/poets/:slug/:rest*",
            "destination": "/sd/poet/:slug",
            "permanent": true
        },
        {
            "source": "/tags",
            "destination": "/sd/explore",
            "permanent": true
        },
        {
            "source": "/tags/:slug",
            "destination": "/sd/tag/:slug",
            "permanent": true
        },
        {
            "source": "/tags/:slug/:rest*",
            "destination": "/sd/tag/:slug",
            "permanent": true
        },
        {
            "source": "/periods",
            "destination": "/sd/period",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/periods",
            "destination": "/:lang/period",
            "permanent": true
        },
        {
            "source": "/home",
            "destination": "/sd",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/home",
            "destination": "/:lang",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/tags",
            "destination": "/:lang/explore",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/tags/:slug",
            "destination": "/:lang/tag/:slug",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/tags/:slug/:rest*",
            "destination": "/:lang/tag/:slug",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/poets/:slug",
            "destination": "/:lang/poet/:slug",
            "permanent": true
        },
        {
            "source": "/:lang(en|sd)/poets/:slug/:rest*",
            "destination": "/:lang/poet/:slug",
            "permanent": true
        },
        {
            "source": "/privacy",
            "destination": "/sd/privacy",
            "permanent": true
        },
        {
            "source": "/about",
            "destination": "/sd/about",
            "permanent": true
        },
        {
            "source": "/contact",
            "destination": "/sd/contact",
            "permanent": true
        },
        {
            "source": "/prosody",
            "destination": "/sd/prosody",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/llms.txt",
            "headers": [
                { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=21600" }
            ]
        },
        {
            "source": "/.well-known/llms.txt",
            "headers": [
                { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=21600" }
            ]
        },
        {
            "source": "/:file(.*).md",
            "headers": [
                { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        },
        {
            "source": "/.well-known/ai-catalog.json",
            "headers": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        },
        {
            "source": "/.well-known/api-catalog",
            "headers": [
                { "key": "Content-Type", "value": "application/linkset+json" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" },
                { "key": "Link", "value": "<https://www.rfc-editor.org/rfc/rfc9727>; rel=\"profile\"" }
            ]
        },
        {
            "source": "/.well-known/agent-skills/index.json",
            "headers": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        },
        {
            "source": "/.well-known/agent-skills",
            "headers": [
                { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        },
        {
            "source": "/.well-known/agent-skills/baakh-archive/SKILL.md",
            "headers": [
                { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Cache-Control", "value": "public, max-age=3600" }
            ]
        }
    ],
    "routes": [
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/favicon.svg",
            "dest": "/public/favicon.svg"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/llms.txt",
            "dest": "/api/index.php"
        },
        {
            "src": "/llms.md",
            "dest": "/api/index.php"
        },
        {
            "src": "/index.md",
            "dest": "/public/index.md"
        },
        {
            "src": "/agents.md",
            "dest": "/public/agents.md"
        },
        {
            "src": "/auth.md",
            "dest": "/public/auth.md"
        },
        {
            "src": "/developers.md",
            "dest": "/public/developers.md"
        },
        {
            "src": "/api.md",
            "dest": "/public/api.md"
        },
        {
            "src": "/skill.md",
            "dest": "/public/skill.md"
        },
        {
            "src": "/agent.md",
            "dest": "/public/agent.md"
        },
        {
            "src": "/developer.md",
            "dest": "/public/developer.md"
        },
        {
            "src": "/.well-known/llms.txt",
            "dest": "/api/index.php"
        },
        {
            "src": "/.well-known/ai-catalog.json",
            "dest": "/public/.well-known/ai-catalog.json"
        },
        {
            "src": "/.well-known/api-catalog",
            "dest": "/public/.well-known/api-catalog.json"
        },
        {
            "src": "/.well-known/agent-skills",
            "dest": "/public/.well-known/agent-skills/index.md"
        },
        {
            "src": "/.well-known/agent-skills/",
            "dest": "/public/.well-known/agent-skills/index.md"
        },
        {
            "src": "/.well-known/agent-skills/index.md",
            "dest": "/public/.well-known/agent-skills/index.md"
        },
        {
            "src": "/.well-known/agent-skills/index.json",
            "dest": "/public/.well-known/agent-skills/index.json"
        },
        {
            "src": "/.well-known/agent-skills/baakh-archive/SKILL.md",
            "dest": "/public/.well-known/agent-skills/baakh-archive/SKILL.md"
        },
        {
            "src": "/.well-known/(.*)",
            "dest": "/api/index.php"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/vendor/(.*)",
            "dest": "/public/vendor/$1"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/public/storage/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_EMERGENCY_PATH": "/tmp/laravel.log",
        "LOG_SINGLE_PATH": "/tmp/laravel.log",
        "SESSION_DRIVER": "cookie",
        "DB_CONNECTION": "mysql"
    }
}
