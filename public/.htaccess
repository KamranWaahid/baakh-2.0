<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Enable Gzip for assets to improve load speed
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain
        AddOutputFilterByType DEFLATE text/html
        AddOutputFilterByType DEFLATE text/xml
        AddOutputFilterByType DEFLATE text/css
        AddOutputFilterByType DEFLATE application/xml
        AddOutputFilterByType DEFLATE application/xhtml+xml
        AddOutputFilterByType DEFLATE application/rss+xml
        AddOutputFilterByType DEFLATE application/javascript
        AddOutputFilterByType DEFLATE application/x-javascript
        
        # Add Vary: Accept-Encoding to help proxy caches
        <IfModule mod_headers.c>
            Header append Vary Accept-Encoding
        </IfModule>
    </IfModule>

    RewriteEngine On

    # Google OAuth callback query strings (code, scope=https://...) are often
    # blocked by cPanel ModSecurity. Primary web login uses Google Identity
    # Services in a popup so this path is only a fallback. LiteSpeed honors
    # this per-URL skip; Apache ignores the unknown env flag.
    RewriteRule ^auth/google-callback$ - [E=noabort:1]
    RewriteRule ^api/auth/google/(mobile|handshake)$ - [E=noabort:1]

    # Force apex host before anything else (incl. robots.txt / ErrorDocument).
    # beta's vhost must share this public/ dir; otherwise fix the host in cPanel.
    RewriteCond %{HTTP_HOST} ^(www|beta)\.baakh\.com$ [NC]
    RewriteRule ^ https://baakh.com%{REQUEST_URI} [L,R=301]

    # Mark hashed Vite JS/CSS so they can be cached forever (content-hash in filename).
    RewriteRule ^build/assets/.*\.(js|css)$ - [E=VITE_HASHED_ASSET:1,NC]

    # Hashed Vite assets: long cache. Manifest/JSON: revalidate. Images/fonts: long cache.
    # HTML SPA shells get no-cache from Laravel SecurityHeaders (PHP responses).
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable" env=VITE_HASHED_ASSET
        Header set Access-Control-Allow-Origin "*" env=VITE_HASHED_ASSET

        <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot|ico)$">
            Header set Access-Control-Allow-Origin "*"
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>

        <FilesMatch "\.(json)$">
            Header set Cache-Control "no-cache, must-revalidate"
            Header set Access-Control-Allow-Origin "*"
        </FilesMatch>
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing files directly (avoids edge cases where -f is evaluated late on some hosts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Missing Vite assets must 404 instead of falling through to Laravel and returning HTML.
    RewriteCond %{REQUEST_URI} ^/build/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
